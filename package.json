{
  "name": "ambient-harmony-generator",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "bun run check && bun run build:ui && bun build.ts",
    "build:ui": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "package": "bun run build && ableton-extensions-cli package",
    "release": "bun scripts/release.ts",
    "start": "bun run build && ableton-extensions-cli run",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@ableton-extensions/sdk": "file:extensions-sdk-1.0.0-beta.1/ableton-extensions-sdk-1.0.0-beta.1.tgz"
  },
  "devDependencies": {
    "@ableton-extensions/cli": "file:extensions-sdk-1.0.0-beta.1/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "^1.3.11",
    "@types/node": "^24.10.0",
    "esbuild": "0.28.1",
    "svelte": "^5.46.1",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
